# Supabase — preencher com o projeto da LUMII (projeto separado da Handify)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-LUMII.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-lumii-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-lumii-aqui

# Payt — HMAC secret para validação de webhooks (novo secret, diferente da Handify)
PAYT_WEBHOOK_SECRET=seu-secret-payt-lumii-aqui

# Panda Video (pode ser a mesma conta)
PANDA_VIDEO_API_KEY=sua-api-key-panda-aqui

# Resend (pode ser a mesma conta)
RESEND_API_KEY=re_sua-key-aqui

# URL pública da aplicação (sem barra no final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave para criptografar CPF — GERE UMA NOVA, nunca reuse a da Handify
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERTIFICATE_ENCRYPTION_KEY=gere-uma-nova-chave-32-bytes-hex

# Chaves VAPID para push notifications — gere novas
# node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log('PUBLIC:',k.publicKey,'\nPRIVATE:',k.privateKey)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-vapid-public-key-87-chars
VAPID_PRIVATE_KEY=sua-vapid-private-key

# Segredo para proteger endpoints de cron
CRON_SECRET=seu-cron-secret-aqui

# Segredo para tokens de embed
EMBED_TOKEN_SECRET=seu-secret-embed-aqui

# Testes E2E (Playwright) — conta de teste, criada via `npm run test:e2e:setup-user`
E2E_TEST_EMAIL=e2e-test@lumiieduca.com.br
E2E_TEST_PASSWORD=SenhaTesteE2E2026!
